@model App.Models.Autocompletar;
@{
    ViewData["Title"] = "Etiquetas";
    string message = null;
    if(ViewBag.message != null)
    {
        message = ViewBag.message;
    }
}

<style>
    .required::after {
        content: "*";
        color: red;
        margin-left: 4px;
    }

    .field-help {
        display: inline-block;
        margin-left: 5px;
        color: #6c757d;
        font-size: 0.875em;
    }

    .modal-body img {
        max-width: 100%;
        height: auto;
        margin: 10px 0;
    }

    .instruction-section {
        margin-bottom: 20px;
        padding: 10px;
        border-left: 3px solid #0d6efd;
        background-color: #f8f9fa;
    }

    /* Estilo para manter largura do botão fixa */
    .btn {
        min-width: 120px; /* Aumentado para melhor acomodação */
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    
    /* Container para os pontos com largura fixa */
    .loading-dots {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        font-size: 20px;
        line-height: 20px;
        visibility: hidden;
    }

    /* Animação dos pontos */
    @@keyframes dots {
        0% { content: ""; }
        25% { content: "•"; }
        50% { content: "••"; }
        75% { content: "•••"; }
        100% { content: ""; }
    }

    .loading-dots::after {
        content: "";
        animation: dots 1.5s infinite;
        display: inline-block;
    }

    .loading-dots.show {
        visibility: visible;
    }

    .button-text {
        position: relative;
    }
</style>

<div>
    <h1 class="display-4 text-center">@ViewData["Title"]</h1>
    <div class="text-end mb-3">
        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#helpModal">
            <span class="button-text"><i class="fas fa-question-circle"></i> Ajuda</span>
        </button>
    </div>
</div>

<!-- Modal de Ajuda -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="helpModalLabel">Guia de Uso - Criação de Etiquetas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="instruction-section">
                    <h6>Campos Principais</h6>
                    <ul>
                        <li><strong>Empresa:</strong> Selecione a empresa para a qual as etiquetas serão geradas.</li>
                        <li><strong>Tipo de Etiqueta:</strong> Escolha o modelo de etiqueta que será utilizado na impressão.</li>
                    </ul>
                </div>

                <div class="instruction-section">
                    <h6>Conteúdo da Etiqueta</h6>
                    <ul>
                        <li><strong>Cliente/Fornecedor:</strong> Opcional - Vincule as etiquetas a um cliente ou fornecedor específico.</li>
                        <li><strong>Tabela de Preço:</strong> Opcional - Selecione uma tabela de preços específica para os valores das etiquetas.</li>
                    </ul>
                </div>

                <div class="instruction-section">
                    <h6>Opções de Impressão</h6>
                    <ul>
                        <li><strong>Dados ao Lado do Código de Barras:</strong> Posiciona as informações ao lado do código de barras, economizando espaço vertical.</li>
                        <li><strong>Imprimir Código de Barras:</strong> Inclui o código de barras na etiqueta.</li>
                        <li><strong>Imprimir Numeração:</strong> Mostra o número do código de barras abaixo dele.</li>
                        <li><strong>Imprimir Código:</strong> Exibe o código do produto na etiqueta.</li>
                        <li><strong>Imprimir Nome:</strong> Mostra o nome do produto na etiqueta.</li>
                        <li><strong>Imprimir Preço:</strong> Inclui o preço do produto na etiqueta.
                            <ul>
                                <li><strong>como código:</strong> Quando marcada, converte o preço para um código de 6 dígitos (exemplo: R$ 32,50 torna-se "003250").</li>
                            </ul>
                        </li>
                        <li><strong>Imprimir Marca:</strong> Exibe a marca do produto na etiqueta.</li>
                        <li><strong>Imprimir Borda:</strong> Adiciona uma borda ao redor da etiqueta.</li>
                        <li><strong>Imprimir Lote:</strong> Inclui informações do lote na etiqueta.</li>
                        <li><strong>Utilizar Número de Série:</strong> Adiciona o número de série do produto na etiqueta.</li>
                    </ul>
                </div>

                <div class="instruction-section">
                    <h6>Adicionando Produtos</h6>
                    <ul>
                        <li><strong>Depósito:</strong> Opcional - Selecione o depósito de origem dos produtos.</li>
                        <li><strong>Código do Produto:</strong> Digite ou selecione o código do produto - preenchimento automático do nome.</li>
                        <li><strong>Nome do Produto:</strong> Digite ou selecione o nome do produto - preenchimento automático do código.</li>
                        <li>Use o botão "Adicionar" para incluir o produto na lista.</li>
                        <li>Ajuste a quantidade, lote e número de série conforme necessário na tabela.</li>
                    </ul>
                </div>

                <div class="instruction-section">
                    <h6>Finalizando</h6>
                    <ul>
                        <li><strong>Adicionar:</strong> Inclui um novo produto na lista de etiquetas.</li>
                        <li><strong>Finalizar:</strong> Gera o arquivo de etiquetas para impressão.</li>
                        <li><strong>Limpar:</strong> Remove todos os produtos da lista e reinicia o formulário.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<div>
    <form method="post" action="/Etiquetas/Baixar">
        <div id="form"></div>
        <div class="form-group">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <label for="EmpresaNome" class="fw-bold required">Empresa</label>
                            <input type="hidden" id="EmpresaId" name="empresa" required>
                            <input type="text" class="form-control" id="EmpresaNome" placeholder="Selecione a empresa" required>
                            <datalist id="empresas">
                                @if (Model != null)
                                {
                                    if (Model.empresas != null && Model.empresas.Count > 0)
                                    {
                                        foreach (var item in Model.empresas)
                                        {
                                            <option value="@item.Nome" data-id="@item.Id"></option>
                                        }
                                        <script>
                                            document.addEventListener("DOMContentLoaded", function() {
                                                var firstEmpresa = "@Model.empresas.First().Nome";
                                                var firstEmpresaId = "@Model.empresas.First().Id";
                                                document.getElementById("EmpresaNome").value = firstEmpresa;
                                                document.getElementById("EmpresaId").value = firstEmpresaId;
                                            });
                                        </script>
                                    }
                                }
                            </datalist>
                        </div>
                        <div class="col-6">
                            <label for="TipoEtiquetaNome" class="fw-bold required">Tipo Etiqueta</label>
                            <input type="hidden" id="TipoEtiquetaId" name="etiqueta" required>
                            <input type="text" class="form-control" id="TipoEtiquetaNome" placeholder="Selecione o tipo de etiqueta" required>
                            <datalist id="modelosEtiquetas">
                                @if (Model != null)
                                {
                                    if (Model.modelosEtiquetas != null && Model.modelosEtiquetas.Count > 0)
                                    {
                                        foreach (var item in Model.modelosEtiquetas)
                                        {
                                            <option value="@item.Nome" data-id="@item.Id"></option>
                                        }
                                        <script>
                                            document.addEventListener("DOMContentLoaded", function() {
                                                var firstModelo = "@Model.modelosEtiquetas.First().Nome";
                                                var firstModeloId = "@Model.modelosEtiquetas.First().Id";
                                                document.getElementById("TipoEtiquetaNome").value = firstModelo;
                                                document.getElementById("TipoEtiquetaId").value = firstModeloId;
                                            });
                                        </script>
                                    }
                                }
                            </datalist>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Conteúdo da Etiqueta</h5>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <label for="ClienteFornecedorNome" class="fw-bold">Cliente / Fornecedor</label>
                            <input type="hidden" id="ClienteFornecedorId" name="clienteFornecedor">
                            <input type="text" class="form-control" id="ClienteFornecedorNome" placeholder="Selecione o cliente ou fornecedor">
                            <datalist id="clientesFornecedores">
                                @if (Model != null)
                                {
                                    if (Model.clientes != null && Model.clientes.Count > 0)
                                    {
                                        foreach (var item in Model.clientes)
                                        {
                                            <option value="@item.Nome" data-id="@item.Id">@item.Email</option>
                                        }
                                    }
                                }
                            </datalist>
                        </div>
                        <div class="col-6">
                            <label for="TabelaPrecoNome" class="fw-bold">Tabela de Preço</label>
                            <input type="hidden" id="TabelaPrecoId" name="tabelaDePreco">
                            <input type="text" class="form-control" id="TabelaPrecoNome" placeholder="Selecione a tabela de preço">
                            <datalist id="tabelaDePreco">
                                @if (Model != null)
                                {
                                    if (Model.tabelaDePreco != null && Model.tabelaDePreco.Count > 0)
                                    {
                                        foreach (var item in Model.tabelaDePreco)
                                        {
                                            <option value="@item.Nome" data-id="@item.Id"></option>
                                        }
                                    }
                                }
                            </datalist>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="DadoLadoCodigoBarras" name="dadoLadoCodigoBarras">
                                <label class="form-check-label fw-bold" for="DadoLadoCodigoBarras">
                                    Dados ao Lado do Código de Barras
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirCodigoBarras" name="imprimirCodigoBarras" checked>
                                <label class="form-check-label fw-bold" for="ImprimirCodigoBarras">
                                    Imprimir Código de Barras
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirNumeroCodigoBarras" name="imprimirNumeroCodigoBarras" checked>
                                <label class="form-check-label fw-bold" for="ImprimirNumeroCodigoBarras">
                                    Imprimir Numeração do Código de Barras
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirCodigo" name="imprimirCodigo">
                                <label class="form-check-label fw-bold" for="ImprimirCodigo">
                                    Imprimir Código
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirNome" name="imprimirNome" checked>
                                <label class="form-check-label fw-bold" for="ImprimirNome">
                                    Imprimir Nome
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check d-flex align-items-center">
                                <div class="d-flex align-items-center">
                                    <input class="form-check-input" type="checkbox" value="true" id="ImprimirPreco" name="imprimirPreco" checked onchange="togglePrecoComoCodigo()">
                                    <label class="form-check-label fw-bold ms-2" for="ImprimirPreco">
                                        Imprimir Preço
                                    </label>
                                </div>
                                <span id="precoComoCodigoContainer" class="ms-4" style="display: inline-block;">
                                    (<span class="d-inline-flex align-items-center gap-1">
                                        <input class="form-check-input me-1" type="checkbox" value="true" id="PrecoComoCodigo" name="precoComoCodigo" checked>
                                        <label class="form-check-label" for="PrecoComoCodigo" style="white-space: nowrap;">
                                            como código
                                        </label>
                                    </span>)
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirMarca" name="imprimirMarca">
                                <label class="form-check-label fw-bold" for="ImprimirMarca">
                                    Imprimir Marca
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirBorda" name="imprimirBorda" checked>
                                <label class="form-check-label fw-bold" for="ImprimirBorda">
                                    Imprimir Borda
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirLote" name="imprimirLote">
                                <label class="form-check-label fw-bold" for="ImprimirLote">
                                    Imprimir Lote
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="true" id="ImprimirNumeroSerie" name="imprimirNumeroSerie">
                                <label class="form-check-label fw-bold" for="ImprimirNumeroSerie">
                                    Utilizar Número de Série
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Conteúdo da Etiqueta</h5>
                    <hr />
                    <div class="row">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle text-center text-nowrap">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Produto</th>
                                        <th>Quantidade</th>
                                        <th>Preço</th>
                                        <th>Lote</th>
                                        <th>Nº Série</th>
                                        <th>Unidade</th>
                                        <th>Marca</th>
                                        <th>Ação</th>
                                    </tr>
                                </thead>
                                <tbody id="Lista-de-itens">
                                    
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-4">
                            <label for="DepositoNome" class="fw-bold">Depósito</label>
                            <input type="hidden" id="DepositoId" name="deposito">
                            <input type="text" class="form-control" id="DepositoNome" placeholder="Selecione o depósito">
                            <datalist id="deposito">
                                @if (Model != null)
                                {
                                    if (Model.depositos != null && Model.depositos.Count > 0)
                                    {
                                        foreach (var item in Model.depositos)
                                        {
                                            <option value="@item.Nome" data-id="@item.Id"></option>
                                        }
                                    }
                                }
                            </datalist>
                        </div>
                        <div class="col-4">
                            <label for="CodigoNFe" class="fw-bold required">Código do Produto</label>
                            <input type="text" class="form-control" id="CodigoNFe" placeholder="Selecione o código do produto" list="codigoProduto">
                            <datalist id="codigoProduto">
                                @if (Model != null)
                                {
                                    if (Model.produtos != null && Model.produtos.Count > 0)
                                    {
                                        foreach (var item in Model.produtos
                                            .OrderBy(p => {
                                                var parts = p.CodigoNFe?.Split('-');
                                                if (parts == null || parts.Length == 0) return (int.MaxValue, int.MaxValue);
                                                
                                                // Tenta converter a primeira parte
                                                int.TryParse(parts[0], out int firstPart);
                                                
                                                // Se tem segunda parte, tenta converter
                                                int secondPart = 0;
                                                if (parts.Length > 1)
                                                    int.TryParse(parts[1], out secondPart);
                                                
                                                return (firstPart, secondPart);
                                            }))
                                        {
                                            <option value="@item.CodigoNFe" data-id="@item.Id" data-nome="@item.Nome">@item.Nome</option>
                                        }
                                    }
                                }
                            </datalist>
                        </div>
                        <div class="col-4">
                            <label for="Produto" class="fw-bold required">Nome do Produto</label>
                            <input type="text" class="form-control" id="Produto" placeholder="Selecione o nome do produto" list="produto">
                            <datalist id="produto">
                                @if (Model != null)
                                {
                                    if (Model.produtos != null && Model.produtos.Count > 0)
                                    {
                                        foreach (var item in Model.produtos.OrderBy(p => p.Nome))
                                        {
                                            <option value="@item.Nome" data-id="@item.Id" data-codigo="@item.CodigoNFe">@item.CodigoNFe</option>
                                        }
                                    }
                                }
                            </datalist>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div class="float-end">
                <button type="button" class="btn btn-primary" onclick="validarEAdicionar()" title="Adicionar produto à lista de etiquetas" id="btnAdicionar">
                    <span class="button-text">Adicionar</span><span class="loading-dots"></span>
                </button>
                <button type="button" class="btn btn-success" onclick="validarFinalizacao(event)" title="Finalizar e visualizar a lista de etiquetas" id="btnFinalizar">
                    <span class="button-text">Finalizar</span><span class="loading-dots"></span>
                </button>
                <button type="reset" class="btn btn-danger" onclick="ResetForm()">Limpar</button>
            </div>
            <br />
        </div>
    </form>
</div>

<script>
    // Função para sincronizar campos de nome com seus IDs
    function setupFieldSync(nameFieldId, hiddenFieldId, datalistId) {
        var nameField = document.getElementById(nameFieldId);
        var hiddenField = document.getElementById(hiddenFieldId);
        
        nameField.setAttribute("list", datalistId);
        
        nameField.addEventListener("change", function() {
            var datalist = document.getElementById(datalistId);
            var options = datalist.getElementsByTagName("option");
            for (var i = 0; i < options.length; i++) {
                if (options[i].value === this.value) {
                    hiddenField.value = options[i].getAttribute("data-id");
                    break;
                }
            }
        });
    }

    // Configurar sincronização para todos os campos
    document.addEventListener("DOMContentLoaded", function() {
        setupFieldSync("EmpresaNome", "EmpresaId", "empresas");
        setupFieldSync("TipoEtiquetaNome", "TipoEtiquetaId", "modelosEtiquetas");
        setupFieldSync("ClienteFornecedorNome", "ClienteFornecedorId", "clientesFornecedores");
        setupFieldSync("TabelaPrecoNome", "TabelaPrecoId", "tabelaDePreco");
        setupFieldSync("DepositoNome", "DepositoId", "deposito");

        // Sincronização entre código e nome do produto
        document.getElementById("CodigoNFe").addEventListener("change", function() {
            if (this.value !== "") {
                // Procura o produto pelo código
                var datalist = document.getElementById("codigoProduto");
                var options = datalist.getElementsByTagName("option");
                for (var i = 0; i < options.length; i++) {
                    if (options[i].value === this.value) {
                        document.getElementById("Produto").value = options[i].getAttribute("data-nome");
                        break;
                    }
                }
            }
        });

        document.getElementById("Produto").addEventListener("change", function() {
            if (this.value !== "") {
                // Procura o código pelo produto
                var datalist = document.getElementById("produto");
                var options = datalist.getElementsByTagName("option");
                for (var i = 0; i < options.length; i++) {
                    if (options[i].value === this.value) {
                        document.getElementById("CodigoNFe").value = options[i].getAttribute("data-codigo");
                        break;
                    }
                }
            }
        });

        // Inicializar tooltips do Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        togglePrecoComoCodigo();
    });

    function validarEAdicionar() {
        var codigo = document.getElementById("CodigoNFe").value;
        var nome = document.getElementById("Produto").value;
        
        if (!codigo || !nome) {
            alert("O código e o nome do produto são obrigatórios para adicionar um item.");
            return;
        }
        
        // Show loading state
        var btnAdicionar = document.getElementById('btnAdicionar');
        btnAdicionar.disabled = true;
        btnAdicionar.querySelector('.button-text').style.visibility = 'hidden';
        btnAdicionar.querySelector('.loading-dots').classList.add('show');
        
        AdicionaItem();
    }

    AdicionaItem = function () {
        var deposito = document.getElementById("DepositoNome").value;
        var produto = document.getElementById("Produto").value;
        var codigoNFe = document.getElementById("CodigoNFe").value;
        var produtoId = "";
        
        // Se o código do produto foi preenchido, use-o para buscar o produto
        if (codigoNFe !== "") {
            // Procura o produto pelo código
            var datalist = document.getElementById("codigoProduto");
            var options = datalist.getElementsByTagName("option");
            for (var i = 0; i < options.length; i++) {
                if (options[i].value === codigoNFe) {
                    produto = options[i].getAttribute("data-nome");
                    produtoId = options[i].getAttribute("data-id");
                    break;
                }
            }
        } else if (produto !== "") {
            // Procura o produto pelo nome
            var datalist = document.getElementById("produto");
            var options = datalist.getElementsByTagName("option");
            for (var i = 0; i < options.length; i++) {
                if (options[i].value === produto) {
                    codigoNFe = options[i].getAttribute("data-codigo");
                    produtoId = options[i].getAttribute("data-id");
                    break;
                }
            }
        }
        
        if (produto === "" || produtoId === "") {
            window.alert("O campo produto ou código do produto deve estar preenchido.");
            resetAddButton();
            return;
        }
        
        document.getElementById("DepositoNome").value = "";
        document.getElementById("Produto").value = "";
        document.getElementById("CodigoNFe").value = "";
        
        if(!document.getElementById(produtoId)){
            var url = "/Etiquetas/GetProduto";
            $.post(url, { "deposito": deposito, "produto": produtoId }, function (data) {
                var produto = JSON.parse(data);
                var row = document.getElementById("Lista-de-itens").insertRow(-1);
                row.id = produto.Id;

                var cell1 = row.insertCell(0);  // Código
                var cell2 = row.insertCell(1);  // Produto
                var cell3 = row.insertCell(2);  // Quantidade
                var cell4 = row.insertCell(3);  // Preço
                var cell5 = row.insertCell(4);  // Lote
                var cell6 = row.insertCell(5);  // Nº Série
                var cell7 = row.insertCell(6);  // Unidade
                var cell8 = row.insertCell(7);  // Marca
                var cell9 = row.insertCell(8);  // Ação

                cell1.innerHTML = produto.CodigoNFe || produto.Codigo;
                cell2.innerHTML = produto.Nome;
                cell3.innerHTML = '<input type="number" id="' + produto.Id + 'Quantidade" min="1" step="1" value="1" class="form-control form-control-sm" onchange="AtualizaQuantidadeItem(\'' + produto.Id + '\')">';
                cell4.innerHTML = parseFloat(produto.PrecoVenda || 0).toFixed(2);
                cell5.innerHTML = '<input type="text" id="' + produto.Id + 'Lote" class="form-control form-control-sm" onchange="AtualizaLoteItem(\'' + produto.Id + '\')">';
                cell6.innerHTML = '<input type="text" id="' + produto.Id + 'NumeroSerie" class="form-control form-control-sm" onchange="AtualizaNumeroSerieItem(\'' + produto.Id + '\')">';
                cell7.innerHTML = produto.Unidade || 'UN';
                cell8.innerHTML = produto.Marca || '';
                cell9.innerHTML = '<button type="button" class="btn btn-danger btn-sm" onclick="RemoveItem(\'' + produto.Id + '\')"><i class="fas fa-trash"></i></button>';
                
                // Adiciona input hidden para o form com os valores iniciais
                document.getElementById("form").innerHTML += '<input type="hidden" id="' + produto.Id + 'form" name="itens" value="' + produto.Id + ',1,,">'; // Inicializa com id, quantidade=1, lote vazio e numeroSerie vazio
                
                // Reset button state after successful addition
                resetAddButton();
            }).fail(function() {
                alert("Erro ao adicionar o produto. Por favor, tente novamente.");
                resetAddButton();
            });
        } else {
            resetAddButton();
        }
    }

    function resetAddButton() {
        var btnAdicionar = document.getElementById('btnAdicionar');
        btnAdicionar.disabled = false;
        btnAdicionar.querySelector('.button-text').style.visibility = 'visible';
        btnAdicionar.querySelector('.loading-dots').classList.remove('show');
    }

    RemoveItem = function (id) {
        var row = document.getElementById(id);
        row.parentNode.removeChild(row);
        // Remove o input hidden correspondente
        var hiddenInput = document.getElementById(id + "form");
        if (hiddenInput) {
            hiddenInput.parentNode.removeChild(hiddenInput);
        }
    }

    // Funções para atualizar os valores no form
    AtualizaQuantidadeItem = function (id) {
        var quantidade = document.getElementById(id + "Quantidade").value;
        var lote = document.getElementById(id + "Lote").value || '';
        var numeroSerie = document.getElementById(id + "NumeroSerie").value || '';
        document.getElementById(id + "form").value = [id, quantidade, lote, numeroSerie].join(',');
    }

    AtualizaLoteItem = function (id) {
        var quantidade = document.getElementById(id + "Quantidade").value;
        var lote = document.getElementById(id + "Lote").value || '';
        var numeroSerie = document.getElementById(id + "NumeroSerie").value || '';
        document.getElementById(id + "form").value = [id, quantidade, lote, numeroSerie].join(',');
    }

    AtualizaNumeroSerieItem = function (id) {
        var quantidade = document.getElementById(id + "Quantidade").value;
        var lote = document.getElementById(id + "Lote").value || '';
        var numeroSerie = document.getElementById(id + "NumeroSerie").value || '';
        document.getElementById(id + "form").value = [id, quantidade, lote, numeroSerie].join(',');
    }

    ResetForm = function (){
        document.getElementById('Lista-de-itens').innerHTML = '';
        document.getElementById('form').innerHTML = '';
    }

    function validarFinalizacao(event) {
        var tbody = document.getElementById('Lista-de-itens');
        if (!tbody || tbody.rows.length === 0) {
            alert('Adicione pelo menos um produto à lista antes de finalizar.');
            return false;
        }
        
        // Show loading state
        var btnFinalizar = document.getElementById('btnFinalizar');
        btnFinalizar.disabled = true;
        btnFinalizar.querySelector('.button-text').style.visibility = 'hidden';
        btnFinalizar.querySelector('.loading-dots').classList.add('show');
        
        // Submit the form
        btnFinalizar.closest('form').submit();
        
        // Reset button state after a short delay (for when user comes back)
        setTimeout(function() {
            btnFinalizar.disabled = false;
            btnFinalizar.querySelector('.button-text').style.visibility = 'visible';
            btnFinalizar.querySelector('.loading-dots').classList.remove('show');
        }, 2000);
        
        return true;
    }

    function togglePrecoComoCodigo() {
        var imprimirPreco = document.getElementById('ImprimirPreco');
        var precoComoCodigoContainer = document.getElementById('precoComoCodigoContainer');
        var precoComoCodigo = document.getElementById('PrecoComoCodigo');
        
        if (imprimirPreco.checked) {
            precoComoCodigoContainer.style.display = 'inline';
        } else {
            precoComoCodigoContainer.style.display = 'none';
            precoComoCodigo.checked = false;
        }
    }
</script>